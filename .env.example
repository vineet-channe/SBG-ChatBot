# Copy to .env.local and fill in. .env.local is git-ignored.

# Enables Claude. Without it, Sterling runs in retrieval-only mode.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (defaults to a current model).
ANTHROPIC_MODEL=

# Optional: reasoning effort, low | medium | high. Low keeps chat replies fast.
ANTHROPIC_EFFORT=low

# Optional: set to 1 to force retrieval-only mode even with a key.
STERLING_OFFLINE=
